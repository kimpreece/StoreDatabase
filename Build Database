-- ------------------------------------------------------------
-- 4. CREATE THE SALES TABLE
-- ------------------------------------------------------------

CREATE TABLE sales (
    SaleID INT PRIMARY KEY,
    ProductID INT,
    Quantity INT,
    SalePrice DECIMAL(8,2),
    SaleDate DATE,
    
    FOREIGN KEY (ProductID) REFERENCES products(ProductID)
);


