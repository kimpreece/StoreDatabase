CREATE DATABASE store_db;

USE store_db;


-- ------------------------------------------------------------
-- 2. CREATE THE PRODUCTS TABLE
-- ------------------------------------------------------------

CREATE TABLE products (
    ProductID INT PRIMARY KEY,
    ProductName VARCHAR(50),
    Category VARCHAR(30),
    Price DECIMAL(8,2),
    Stock INT
);


